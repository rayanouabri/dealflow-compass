# ============================================================================
# AI-VC SaaS Configuration Template
# Copy this to .env.local (for development) or set in Supabase/Vercel dashboard
# NEVER commit real secrets!
# ============================================================================

# === SUPABASE (Required) ===
# Get from: https://app.supabase.com > Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIs...
# Service role (Edge Functions only, NEVER expose to client):
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_URL=https://your-project.supabase.co

# === AI PROVIDER (Pick one: gemini, vertex, or groq) ===
AI_PROVIDER=gemini

# Gemini API (free: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...
GEMINI_KEY_2=AIzaSy...  # Backup key
GEMINI_MODEL=gemini-2.5-pro

# Vertex AI (GCP enterprise)
VERTEX_AI_PROJECT_ID=my-gcp-project
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-pro
VERTEX_AI_CREDENTIALS={"type":"service_account",...}

# Groq API (free: https://console.groq.com)
GROQ_API_KEY=gsk_...

# === SEARCH APIs (Serper + Brave fallback) ===
# Serper: https://serper.dev (100 free/month)
SERPER_API_KEY=xxxxxxx

# Brave: https://brave.com/search/api (100 free/month)
BRAVE_API_KEY=xxxxxxx

# === STRIPE PAYMENT (Optional, for monetization) ===
STRIPE_SECRET_KEY=sk_live_xxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxx  # Frontend only
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxx
STRIPE_PRICE_ID_STARTER=price_xxx
STRIPE_PRICE_ID_PROFESSIONAL=price_yyy

# === OPTIONAL: DigitalOcean AI Agents ===
DO_AGENT_ENDPOINT=https://api.digitalocean.com/v2/compute/agents
DO_AGENT_API_KEY=xxxxxxx

# ============================================================================
# IMPORTANT SECURITY NOTES:
# ============================================================================
# 1. .env.local is local development only and in .gitignore
# 2. For Edge Functions: set secrets in Supabase Dashboard > Functions > Secrets
# 3. For Vercel: set in Dashboard > Settings > Environment Variables
# 4. Never commit this file with real secrets
# 5. Rotate API keys periodically
# 6. Use different keys for dev/staging/production
# ============================================================================

# See SECRETS_CONFIGURATION.md for detailed setup instructions
